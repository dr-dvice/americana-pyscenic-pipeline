/*
 * pySCENIC Cross-Species Regulon Analysis Pipeline — Configuration
 */

params {
    // ── Species-specific (override in profiles or CLI) ──────────────────────
    species_name       = null
    gff                = null
    genome_fasta       = null
    atlas_h5ad         = null
    ortholog_file      = null   // set to import pre-computed; leave null to generate from BLAST
    blast_map          = null   // BLAST outfmt6: species protein → fly protein
    sp_headers         = null   // TSV: species protein ID → gene ID
    fly_headers        = '/home/davidbellini/OneDrive/gabbiani/PROJECTS/SAMap_paper1/mydata/fly_headers_prot.tsv'
    cluster_names      = null
    gff_key            = null
    cluster_col        = 'seurat_clusters'
    cluster_name_col   = 'cell_type'

    // ── Shared resources ────────────────────────────────────────────────────
    fly_motif_tbl      = '/home/davidbellini/OneDrive/gabbiani/PROJECTS/all_atlases/SCENIC/fly_motifs/v10nr_clust_public/snapshots/motifs-v10-nr.flybase-m0.00001-o0.0.tbl'
    singularity_image  = '/home/davidbellini/OneDrive/gabbiani/PROJECTS/all_atlases/SCENIC/pyscenic-0.12.1.sif'

    // ── TSS extraction ──────────────────────────────────────────────────────
    upstream_bp        = 5000
    downstream_bp      = 2000

    // ── Motif annotations ───────────────────────────────────────────────────
    min_pident         = 50.0

    // ── Step 0: Export counts ───────────────────────────────────────────────
    use_raw_counts     = false

    // ── Step 4: GRN (set grn_import to skip local GRNBoost2) ────────────────
    grn_import         = null
    tf_list            = null

    // ── Step 5: cisTarget DB (set cistarget_import to skip local build) ─────
    cistarget_import   = null
    motifs_dir         = '/home/davidbellini/OneDrive/gabbiani/PROJECTS/all_atlases/SCENIC/fly_motifs/v10nr_clust_public/singletons'
    motif_list         = null
    cbust_binary       = null
    cistarget_script   = null
    cistarget_prefix   = 'species_db'
    cistarget_seed     = 0
    cistarget_total_parts = 10

    // ── Threading — total CPU budget for the pipeline ─────────────────────
    max_threads        = 20

    // ── Output ──────────────────────────────────────────────────────────────
    outdir             = './results'
}

// ── Process environment mapping ─────────────────────────────────────────────

executor {
    name   = 'local'
    cpus   = params.max_threads
}

process {
    executor = 'local'

    withLabel: 'pyscenic_conda' {
        conda = '/home/davidbellini/programs/anaconda3/envs/pyscenic'
    }

    withLabel: 'cistarget_conda' {
        conda = '/home/davidbellini/programs/anaconda3/envs/create_cistarget_databases'
    }

    withLabel: 'singularity_pyscenic' {
        container = params.singularity_image
    }
}

// ── Singularity ─────────────────────────────────────────────────────────────

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '-B /mnt -B /home'
}

// ── Conda ───────────────────────────────────────────────────────────────────

conda {
    enabled = true
}

// ── Profiles ────────────────────────────────────────────────────────────────

profiles {
    americana {
        includeConfig 'conf/americana.config'
    }
}
